# ===================================================
# PRIV DISCORD BOT EKOSİSTEMİ - ÇEVRE DEĞİŞKENLERİ (.env)
# ===================================================

# Discord Bot Kimlik Bilgileri
# Discord Developer Portal -> Application -> Bot
DISCORD_TOKEN=your_discord_bot_token_here
# Discord Developer Portal -> Application -> General Information
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_CLIENT_SECRET=your_oauth2_client_secret_here

# Bot Genel Yapılandırması
DEFAULT_BOT_NAME=Priv
DEFAULT_PREFIX=/
NODE_ENV=development
PORT=4000
DASHBOARD_URL=http://localhost:5173
API_URL=http://localhost:4000

# Veritabanı Bağlantısı (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/priv_discord_bot?schema=public

# Redis Önbellek (İsteğe bağlı, boş bırakılırsa dahili bellek kullanılır)
REDIS_URL=redis://localhost:6379

# Session ve JWT Güvenlik Anahtarı
SESSION_SECRET=super_secret_session_key_change_me_in_production_min32chars
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min32chars

# OAuth2 Yönlendirme URL'si (Discord Portal ile eşleşmeli)
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Yapay Zeka Modülü (İsteğe bağlı, Google Gemini / OpenAI)
AI_API_KEY=
AI_PROVIDER=gemini

# Varsayılan Sunucu Ayarları
DEFAULT_EMBED_COLOR=#5865F2
DEFAULT_CURRENCY_NAME=Coin
DEFAULT_CURRENCY_EMOJI=🪙
DEFAULT_TIMEZONE=Europe/Istanbul
