{
  "name": "@priv/bot",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); if(!fs.existsSync('dist/assets')) fs.mkdirSync('dist/assets', {recursive:true}); fs.copyFileSync('src/assets/turkish_words.txt', 'dist/assets/turkish_words.txt');\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@priv/shared": "*",
    "@priv/config": "*",
    "@priv/database": "*",
    "discord.js": "^14.15.3",
    "@discordjs/voice": "^0.17.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "@napi-rs/canvas": "^0.1.65"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "vitest": "^2.0.5"
  }
}
